{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "the widget: drags its own window, hears settings and pointer (and, on the Rust core, planet) events, and calls only the commands it uses (photo mode, the game sound it keeps with the settings, and the first-run card's done, among them)",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-settings",
    "allow-tray-title",
    "allow-hide-widget",
    "allow-open-settings",
    "allow-notify",
    "allow-page-state",
    "allow-set-sound",
    "allow-photo",
    "allow-photo-exit",
    "allow-intro-done",
    "allow-planet-start",
    "allow-planet-resend",
    "allow-planet-resize",
    "allow-planet-pointer-down",
    "allow-planet-pointer-move",
    "allow-planet-pointer-up",
    "allow-planet-pointer-cancel",
    "allow-planet-key",
    "allow-planet-train",
    "allow-planet-kaioken",
    "allow-planet-buy",
    "allow-planet-learn",
    "allow-planet-respec",
    "allow-planet-learn-angel",
    "allow-planet-auto-next",
    "allow-planet-wear",
    "allow-planet-pick-wish",
    "allow-planet-pick-hero",
    "allow-planet-menu",
    "allow-planet-angels",
    "allow-planet-ascend-info",
    "allow-planet-god-info",
    "allow-planet-zeno-info",
    "allow-planet-card",
    "allow-planet-fps",
    "allow-planet-itx",
    "allow-planet-itx-jump",
    "allow-planet-view",
    "allow-planet-pixels",
    "allow-planet-mask",
    "allow-planet-sprite",
    "allow-planet-spot",
    "allow-planet-buy-n",
    "allow-planet-shop-info",
    "allow-planet-bulk"
  ]
}
