{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "control",
  "description": "the control centre (fullscreen, the HUD in a window of its own): hears settings, the planet's messages and the app's news, reads the menus and where the planet is, buys, learns and picks, sends keys, leaves fullscreen, and opens settings and photo mode. It never draws the planet, points at it, resizes it or sets its frame rate; the only frame it may read is the share card's, once, just after the card (control.rs)",
  "windows": ["control"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-settings",
    "allow-open-settings",
    "allow-set-sound",
    "allow-photo",
    "allow-photo-exit",
    "allow-fullscreen",
    "allow-planet-resend",
    "allow-planet-key",
    "allow-planet-train",
    "allow-planet-kaioken",
    "allow-planet-buy",
    "allow-planet-buy-n",
    "allow-planet-bulk",
    "allow-planet-shop-info",
    "allow-planet-learn",
    "allow-planet-respec",
    "allow-planet-learn-angel",
    "allow-planet-auto-next",
    "allow-planet-wear",
    "allow-planet-pick-wish",
    "allow-planet-pick-hero",
    "allow-planet-menu",
    "allow-planet-angels",
    "allow-planet-ascend-info",
    "allow-planet-god-info",
    "allow-planet-zeno-info",
    "allow-planet-card",
    "allow-planet-itx",
    "allow-planet-itx-jump",
    "allow-planet-sprite",
    "allow-planet-spot",
    "allow-planet-pixels"
  ]
}
