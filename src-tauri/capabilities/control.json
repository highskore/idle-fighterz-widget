{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "control",
  "description": "the control centre (fullscreen, the HUD in a window of its own): hears settings, the planet's messages and the app's news, reads the menus and where the planet is, buys, learns and picks, sends keys, leaves fullscreen, and opens settings and photo mode. On Windows its page is its own title bar: it drags, resizes, minimises and closes the window. It never draws the planet, points at it, resizes it or sets its frame rate; the frames it may read are layout 3's live planet, a few a second (control.rs)",
  "windows": ["control"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "allow-get-settings",
    "allow-open-settings",
    "allow-set-sound",
    "allow-photo",
    "allow-photo-exit",
    "allow-fullscreen",
    "allow-planet-resend",
    "allow-planet-key",
    "allow-planet-train",
    "allow-planet-kaioken",
    "allow-planet-buy",
    "allow-planet-buy-n",
    "allow-planet-bulk",
    "allow-planet-shop-info",
    "allow-planet-learn",
    "allow-planet-respec",
    "allow-planet-learn-angel",
    "allow-planet-auto-next",
    "allow-planet-wear",
    "allow-planet-pick-wish",
    "allow-planet-pick-hero",
    "allow-planet-menu",
    "allow-planet-angels",
    "allow-planet-ascend-info",
    "allow-planet-god-info",
    "allow-planet-zeno-info",
    "allow-planet-card",
    "allow-planet-itx",
    "allow-planet-itx-jump",
    "allow-planet-sprite",
    "allow-planet-spot",
    "allow-planet-pixels"
  ]
}
