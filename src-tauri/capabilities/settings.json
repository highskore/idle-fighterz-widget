{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "the settings window (compact or full): draws its own title bar (drags and closes itself), hears settings and permission events, and reads and changes the settings; the full one's preview reads the widget's last frame and the game at a glance",
  "windows": ["settings"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-settings",
    "allow-set-settings",
    "allow-notify-permission",
    "allow-request-notify-permission",
    "allow-open-notify-settings",
    "allow-focus-status",
    "allow-snooze",
    "allow-save-profile",
    "allow-delete-profile",
    "allow-apply-profile",
    "allow-quit",
    "allow-glance",
    "allow-preview-frame"
  ]
}
